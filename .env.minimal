# ============================================================================
# MINIMUM ENVIRONMENT VARIABLES - İlk Deployment İçin
# SECURITY WARNING: Never commit real credentials to version control!
# ============================================================================

# ============================================================================
# 1. SUPABASE (ZORUNLU) ✅
# ============================================================================
# Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# 2. OPENAI (ZORUNLU) ✅
# ============================================================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# 3. APP URL (ZORUNLU) ✅
# ============================================================================
# Coolify'dan alacağın domain veya IP
APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
DOMAIN=your-domain.com

# ============================================================================
# 4. NODE ENV (ZORUNLU) ✅
# ============================================================================
NODE_ENV=production
ENVIRONMENT=production

# ============================================================================
# 5. CORS & SECURITY (ZORUNLU) ✅
# ============================================================================
# SECURITY: Restrict CORS to your actual domain in production
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================================================
# OPSIYONEL - Sonra Eklenebilir ⏭️
# ============================================================================

# Redis (Upstash kullanırsan)
# REDIS_URL=redis://default:xxx@xxx.upstash.io:6379
# REDIS_PASSWORD=your_secure_password

# Stripe (Billing için - sonra ekle)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_TEAM_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Brave Search (Opsiyonel)
# BRAVE_API_KEY=...

# GitHub Token (Opsiyonel)
# GITHUB_TOKEN=ghp_...

# Bot Tokens (Opsiyonel)
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_TOKEN=...
# TELEGRAM_TOKEN=...

# ============================================================================
# ÖZET: İlk deployment için sadece 5 grup yeterli! ✅
# ============================================================================
# 1. Supabase (3 key)
# 2. OpenAI (1-2 key)
# 3. App URL (3 değişken)
# 4. Node ENV (2 değişken)
# 5. CORS Security (1 değişken)
#
# TOPLAM: 10-11 environment variable
# ============================================================================
