# =============================================================================
# StackMemory — Environment Configuration (v3.2)
# =============================================================================
# Architecture: frontend (Next.js) → MCP server (Cloudflare D1 + Vectorize).
# Identity / billing / teams stay on Supabase. There is no separate backend
# or bridge service anymore.
# =============================================================================

# ---- App ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOMAIN=localhost

# Local-only auth shim (skips Supabase). Useful for offline dev.
STACKMEMORY_LOCAL_MODE=false
NEXT_PUBLIC_STACKMEMORY_LOCAL_MODE=false

# ---- MCP Server (single source of truth for memories + brain) ----
# Live endpoint:  https://stackmemory-mcp.pages.dev/mcp
# Self-host:      http://localhost:8787/mcp  (docker compose --profile selfhost)
MCP_SERVER_URL=https://stackmemory-mcp.pages.dev/mcp
NEXT_PUBLIC_MCP_SERVER_URL=https://stackmemory-mcp.pages.dev/mcp
# Optional bearer token for self-hosted MCP deployments with auth enabled.
MCP_SERVER_TOKEN=

# ---- Supabase (identity / billing / teams ONLY — not memories) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM access (chat features in the dashboard) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- Optional integrations ----
BRAVE_API_KEY=
GITHUB_TOKEN=
NOTION_API_KEY=

# ---- Bots (opt-in via `docker compose --profile bots`) ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_TOKEN=
TELEGRAM_BOT_TOKEN=

# ---- H-score weights (MCP server side; A/B testable) ----
HSCORE_ALPHA=0.40
HSCORE_BETA=0.30
HSCORE_GAMMA=0.15
HSCORE_DELTA=0.15
HSCORE_EPSILON=0.0
HSCORE_LAMBDA=0.5
