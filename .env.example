# AI-ULU Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=production
APP_URL=https://your-domain.com
DOMAIN=your-domain.com
PORT=3000

# ============================================================================
# Supabase Configuration (REQUIRED)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================================
# OpenAI Configuration (REQUIRED)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# Stripe Configuration (REQUIRED for billing)
# ============================================================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_TEAM_PRICE_ID=price_your_team_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_price_id
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=price_your_team_price_id

# ============================================================================
# Redis Configuration (REQUIRED for caching)
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_secure_redis_password

# ============================================================================
# External APIs (Optional)
# ============================================================================
BRAVE_API_KEY=your_brave_search_key_here
GITHUB_TOKEN=ghp_your_github_token_here

# ============================================================================
# Bot Tokens (Optional - for bot services)
# ============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id

TELEGRAM_TOKEN=your-telegram-bot-token

# ============================================================================
# Backend Configuration
# ============================================================================
API_URL=http://backend:8000
ENVIRONMENT=production
CORS_ORIGINS=*

# ============================================================================
# Monitoring (Optional)
# ============================================================================
GRAFANA_PASSWORD=admin

# ============================================================================
# Development
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:3000
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=true
