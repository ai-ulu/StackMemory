# =============================================================================
# StackMemory — Environment Configuration
# =============================================================================
# Current architecture: app-first.
#
# Next.js dashboard/API owns the product service boundary.
# Supabase is the source of truth for auth, memories, memory settings, brain data,
# billing usage and graph-ready memory links.
#
# MCP is now a thin adapter that forwards MCP tool calls into the app API.
# The legacy all-in-one MCP entrypoint is disabled.
# =============================================================================

# ---- App ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOMAIN=localhost
NEXT_PUBLIC_DEFAULT_PLAN=free

# Local-only mode should usually stay false when testing Supabase-backed memory.
STACKMEMORY_LOCAL_MODE=false
NEXT_PUBLIC_STACKMEMORY_LOCAL_MODE=false

# ---- Supabase (auth + app data source of truth) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM access (optional dashboard/chat features) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- MCP app adapter ----
# Used by mcp-server/src/app-adapter.ts when deploying MCP separately.
STACKMEMORY_APP_URL=http://localhost:3000
# Optional: use this only for server-to-server deployments.
# If omitted, the adapter forwards the incoming Authorization header.
STACKMEMORY_APP_TOKEN=

# ---- Optional integrations ----
BRAVE_API_KEY=
GITHUB_TOKEN=
NOTION_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_TOKEN=
TELEGRAM_BOT_TOKEN=
DATABASE_URL=
